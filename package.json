{
  "name": "merch-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A merchandising operations console: unified catalog, inventory risk scoring, vendor health, and promotion economics.",
  "scripts": {
    "dev": "vite",
